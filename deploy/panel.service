[Unit]
Description=BorderX Panel
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/borderx
ExecStart=/opt/borderx/borderx-panel --config /etc/borderx/config.yml
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
